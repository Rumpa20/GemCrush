<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GemDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dlg_in</item>
        <item name="android:windowExitAnimation">@anim/dlg_out</item>
    </style>

    <style name="GemDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dlg_bg</item>
        <item name="android:windowAnimationStyle">@style/GemDialogAnimation</item>
        <item name="android:colorAccent">#FFC94D</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="GemCustomDialog" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/GemDialogAnimation</item>
    </style>
</resources>
